# Public values only — everything prefixed with VITE_ ends up in the browser bundle.
# Never put the Supabase service role key or ADMIN_EMAIL here.

# Backend API origin (no trailing slash)
VITE_API_URL=http://localhost:4000
# Public site origin, used for canonical URLs, Open Graph, sitemap.xml and CSP
VITE_SITE_URL=http://localhost:5173

# Supabase (anon key is designed to be public; RLS protects the data)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hidden admin route — pick a random slug, e.g. /studio-8f3k2. Never link to it.
VITE_ADMIN_PATH=/studio-change-me

# Optional: Cloudflare Turnstile site key (also enable captcha in Supabase Auth settings)
VITE_TURNSTILE_SITE_KEY=
