# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Supabase (backend only — the service role key bypasses RLS, never ship it to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Single-owner admin -----------------------------------------------------
# The only account allowed through requireAdmin. Never put this in the frontend.
ADMIN_EMAIL=you@example.com

# --- CORS / CSP -------------------------------------------------------------
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# --- Optional ---------------------------------------------------------------
# Reverse proxies in front of the API (for the real visitor IP used by rate limiting).
# Leave empty: defaults to 2 on Render (Cloudflare + load balancer), 0 everywhere else.
TRUST_PROXY=
# Shared rate-limit store. Falls back to in-memory when unset.
REDIS_URL=
# Contact form email delivery via Resend. Messages are always stored in Supabase;
# email is sent only when RESEND_API_KEY is set.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Defaults to ADMIN_EMAIL when empty.
CONTACT_TO_EMAIL=

# --- One-off migration only (backend/scripts/migrate-from-mongo.ts) ----------
MONGODB_URI=
